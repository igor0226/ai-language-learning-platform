PORT=3001
# Compose + Caddy (https://app.llp-test.com): same-origin UI and /api — set for future auth cookies + SSR.
CORS_ORIGIN=https://app.llp-test.com
# Host-only dev without Caddy: CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=language-learning-platform
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MEDIA_WORKSPACE_ROOT=/tmp/language-learning-platform-workspace

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_streaming

# Max explanation clips rendered in parallel per video (default 3)
CLIP_GENERATION_CONCURRENCY=3
VIDEO_PROCESSING_CRON_ENABLED=true
VIDEO_PROCESSOR_CRON="*/15 * * * * *"

# Required for Whisper transcription, phrase detection, explanation TTS, and speaking
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# LiveKit (self-hosted in Compose; browser uses LIVEKIT_URL).
# Compose injects LIVEKIT_API_KEY / LIVEKIT_API_SECRET from this file into Nest,
# the teacher agent, and LiveKit. Secret must be at least 32 characters
# (LiveKit logs an error and the API key if it is shorter).
# Compose + Caddy: wss://media.llp-test.com (HTTPS page cannot use ws://localhost).
LIVEKIT_URL=wss://media.llp-test.com
LIVEKIT_API_URL=http://localhost:7880
# Host-only dev without Caddy: LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local_livekit_secret_do_not_use_prod
# ICE host candidate for the browser (Compose maps UDP/TCP ports to the host).
LIVEKIT_NODE_IP=127.0.0.1

SPEAKING_AGENT_NAME=teacher-agent
SPEAKING_TEACHER_MODEL=gpt-realtime-1.5
SPEAKING_TEACHER_VOICE=coral
SPEAKING_CALL_TOKEN_TTL=1h
SPEAKING_EMPTY_ROOM_TIMEOUT_SECONDS=60
SPEAKING_REACTION_DEBOUNCE_MS=800
# Turn-taking: client VAD + STT gate interruptions (ignore coughs / short noise).
SPEAKING_STT_MODEL=gpt-4o-mini-transcribe
SPEAKING_VAD_ACTIVATION_THRESHOLD=0.65
SPEAKING_VAD_MIN_SPEECH_MS=400
SPEAKING_INTERRUPT_MIN_WORDS=3
SPEAKING_INTERRUPT_MIN_DURATION_MS=1500

SPEAKING_STALE_CALL_CRON_ENABLED=true
SPEAKING_STALE_CALL_CRON="0 * * * * *"
SPEAKING_STALE_CALL_GRACE_SECONDS=120

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://app.llp-test.com/api/auth/google/callback
# Required: at least 32 random characters in production
SESSION_SECRET=<YOUR_SESSION_SECRET>
# Optional overrides (defaults derive from CORS_ORIGIN)
# AUTH_SUCCESS_REDIRECT=https://app.llp-test.com/dashboard
# AUTH_FAILURE_REDIRECT=https://app.llp-test.com/login?error=oauth
# SESSION_MAX_AGE_MS=1209600000
