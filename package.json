{
	"name": "video-streaming",
	"version": "1.0.0",
	"private": true,
	"description": "Local language learning platform monorepo (Next frontend + Nest backend)",
	"workspaces": ["packages/contracts", "backend", "frontend"],
	"scripts": {
		"prepare": "husky",
		"dev": "docker compose up",
		"dev:rebuild": "docker compose up --build",
		"dev:clean": "docker compose down --remove-orphans",
		"dev:reset-packages": "./scripts/reset-compose-package-volumes.sh",
		"dev:https-setup": "./scripts/setup-local-https.sh"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"husky": "^9.1.7"
	}
}