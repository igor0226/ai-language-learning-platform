# Local HTTPS via mkcert (see scripts/setup-local-https.sh).
# UI and Nest API share one origin for future auth cookies + SSR.

http://app.llp-test.com {
	redir https://app.llp-test.com{uri}
}

app.llp-test.com {
	tls /certs/llp-test.com.pem /certs/llp-test.com-key.pem

	handle /api/* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}
}

http://media.llp-test.com {
	redir https://media.llp-test.com{uri}
}

media.llp-test.com {
	tls /certs/llp-test.com.pem /certs/llp-test.com-key.pem
	reverse_proxy livekit:7880
}
